# Core
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-string
# Leave these unset for the repository-local defaults.
# DATABASE_URL=sqlite+aiosqlite:///absolute/path/to/data/arxiv_digest.db
# FRONTEND_DIST_DIR=/absolute/path/to/frontend/dist
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Add http://YOUR_LAN_IP:5173 when the frontend calls the API cross-origin.

# Administrator authentication. Set AUTH_COOKIE_SECURE=true only when served through HTTPS.
AUTH_SESSION_HOURS=168
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
AUTH_COOKIE_SECURE=false
# Optional: shared local lease used by the API and worker to recover interrupted runs.
# DAILY_RUN_LOCK_PATH=/absolute/path/to/data/.daily-run.lock

# arXiv asks API clients to identify themselves with a contact address.
ARXIV_CONTACT_EMAIL=researcher@example.com
ARXIV_MIN_INTERVAL_SECONDS=3.1
ARXIV_RETRY_ATTEMPTS=3
ARXIV_RETRY_BASE_SECONDS=20
ARXIV_RETRY_MAX_SECONDS=90
ARXIV_CACHE_TTL_SECONDS=86400
ARXIV_STALE_CACHE_HOURS=168
ARXIV_RSS_CACHE_TTL_SECONDS=10800
ARXIV_RSS_STALE_CACHE_HOURS=168
ARXIV_ATOM_COOLDOWN_BASE_HOURS=6
ARXIV_ATOM_COOLDOWN_MAX_HOURS=24
OPENALEX_ENABLED=true
OPENALEX_MAX_QUERIES_PER_TOPIC=3
OPENALEX_CACHE_TTL_SECONDS=86400
OPENALEX_STALE_CACHE_HOURS=168

# Processing limits
LLM_CONCURRENCY=2
LLM_FALLBACK_MAX_PROFILES=3
LLM_PROFILE_COOLDOWN_SECONDS=600
PDF_MAX_PAGES=30
PDF_MAX_CHARS=120000
HTTP_TIMEOUT_SECONDS=90

# Internet time calibration. The app computes an offset and never changes the OS clock.
NETWORK_TIME_ENABLED=true
NETWORK_TIME_SERVERS=ntp.aliyun.com,time.cloudflare.com,time.google.com,pool.ntp.org
NETWORK_TIME_HTTP_URLS=https://www.baidu.com,https://www.cloudflare.com,https://www.microsoft.com
NETWORK_TIME_TIMEOUT_SECONDS=2.5
NETWORK_TIME_SYNC_INTERVAL_SECONDS=1800
